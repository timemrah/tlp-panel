[Desktop Entry]
Type=Application
Name=TLP Panel
Name[tr]=TLP Paneli
Comment=Live power status and quick actions for TLP
Comment[tr]=TLP için canlı güç durumu ve hızlı eylemler
Exec=tlp-panel

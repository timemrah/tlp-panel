#!/bin/sh
# Privileged helper for TLP Panel.
#
# Runs as root through polkit. It accepts a fixed set of verbs with strictly
# validated arguments, and only ever writes keys from a known allowlist into
# its own drop-in file. Never pass user input to a shell here.

set -eu

CONF_FILE=/etc/tlp.d/90-tlp-panel.conf
CONF_USR=/etc/tlp.conf
STATE_DIR=/var/lib/tlp-panel
ABM_STATE=$STATE_DIR/abm-supported
USR_BACKUP=$STATE_DIR/tlp.conf.orig
TLP_BIN=/usr/sbin/tlp
CPUFREQ_DIR=/sys/devices/system/cpu/cpu0/cpufreq

# Every key the panel manages. Only ever used to find, and comment out, lines
# in /etc/tlp.conf that would otherwise override the panel's own file.
MANAGED_RE='^((START|STOP)_CHARGE_THRESH_BAT[0-9]+|CPU_SCALING_MAX_FREQ_ON_(AC|BAT)|WIFI_PWR_ON_(AC|BAT)|RUNTIME_PM_ON_(AC|BAT)|AMDGPU_ABM_LEVEL_ON_(AC|BAT))='

die() {
    echo "$1" >&2
    exit 1
}

is_percent() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -ge 0 ] && [ "$1" -le 100 ]
}

is_abm_level() {
    case "$1" in
        0|1|2|3|4) return 0 ;;
        *) return 1 ;;
    esac
}

is_on_off() {
    case "$1" in
        on|off) return 0 ;;
        *) return 1 ;;
    esac
}

is_battery_name() {
    case "$1" in
        BAT[0-9]|BAT[0-9][0-9]) return 0 ;;
        *) return 1 ;;
    esac
}

# put_key KEY VALUE — replace or append one key, leaving the rest untouched.
put_key() {
    key="$1"
    value="$2"

    umask 022
    mkdir -p /etc/tlp.d
    if [ ! -f "$CONF_FILE" ]; then
        cat > "$CONF_FILE" <<'EOF'
# Written by TLP Panel. Values you change in the app land here.
# Edit freely; the app only rewrites the keys it manages.
EOF
    fi

    tmp="${CONF_FILE}.tmp.$$"
    grep -v "^${key}=" "$CONF_FILE" > "$tmp" || true
    printf '%s=%s\n' "$key" "$value" >> "$tmp"
    mv "$tmp" "$CONF_FILE"
    chmod 644 "$CONF_FILE"
}

is_on_auto() {
    case "$1" in
        on|auto) return 0 ;;
        *) return 1 ;;
    esac
}

# Frequency ceilings this processor accepts, in kHz, one per line, ascending.
# Drivers that publish no list (intel_pstate) take any value in the hardware
# range, so the two ends are enough to bound it.
cpu_freq_steps() {
    if [ -r "$CPUFREQ_DIR/scaling_available_frequencies" ]; then
        tr ' ' '\n' < "$CPUFREQ_DIR/scaling_available_frequencies" |
            grep -E '^[0-9]+$' | sort -n | uniq
    else
        [ -r "$CPUFREQ_DIR/cpuinfo_min_freq" ] && cat "$CPUFREQ_DIR/cpuinfo_min_freq"
        [ -r "$CPUFREQ_DIR/cpuinfo_max_freq" ] && cat "$CPUFREQ_DIR/cpuinfo_max_freq"
    fi
    return 0
}

cpu_freq_min() { cpu_freq_steps | head -n 1; }
cpu_freq_max() { cpu_freq_steps | tail -n 1; }

is_cpu_freq() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    lo=$(cpu_freq_min)
    hi=$(cpu_freq_max)
    [ -n "$lo" ] && [ -n "$hi" ] || return 1
    [ "$1" -ge "$lo" ] && [ "$1" -le "$hi" ]
}

# Re-apply TLP settings without changing whether the profile is manual.
reapply_tlp() {
    [ -x "$TLP_BIN" ] || return 0
    mode="$(tlp-stat -s 2>/dev/null | awk -F= '/^Mode/ {gsub(/ /, "", $2); print tolower($2)}')"
    case "$mode" in
        ac\(manual\)) "$TLP_BIN" ac >/dev/null 2>&1 || true ;;
        battery\(manual\)) "$TLP_BIN" bat >/dev/null 2>&1 || true ;;
        *) "$TLP_BIN" start >/dev/null 2>&1 || true ;;
    esac
}

# Adaptive backlight runs on the display microcontroller. Without its
# firmware the sysfs knob accepts values and changes nothing, so record
# whether it can work at all — the panel reads this without root.
probe_abm() {
    supported=0
    for info in /sys/kernel/debug/dri/*/amdgpu_firmware_info; do
        [ -r "$info" ] || continue
        dmcu=$(awk -F'[:,]' '/^DMCU feature version/ {gsub(/ /, "", $2); print $2; exit}' "$info")
        dmcub=$(awk -F'[:,]' '/^DMCUB feature version/ {gsub(/ /, "", $4); print $4; exit}' "$info")
        [ -n "${dmcu:-}" ] && [ "$dmcu" != "0" ] && supported=1
        [ -n "${dmcub:-}" ] && [ "$dmcub" != "0x00000000" ] && [ "$dmcub" != "0" ] && supported=1
    done

    # No panel knob at all means the question does not arise.
    knob=0
    for pps in /sys/class/drm/card*/*/amdgpu/panel_power_savings; do
        [ -e "$pps" ] && knob=1
    done
    [ "$knob" = "0" ] && supported=0

    mkdir -p "$STATE_DIR"
    printf '%s\n' "$supported" > "$ABM_STATE"
    chmod 644 "$ABM_STATE"
    echo "$supported"
}

cmd_probe() {
    result=$(probe_abm)
    echo "adaptive backlight supported: ${result}"
}

cmd_set_charge() {
    start="${1:-}"
    stop="${2:-}"
    battery="${3:-BAT0}"

    is_percent "$start" || die "invalid start threshold"
    is_percent "$stop" || die "invalid stop threshold"
    is_battery_name "$battery" || die "invalid battery name"
    [ "$start" -lt "$stop" ] || die "start threshold must be below stop threshold"

    put_key "START_CHARGE_THRESH_${battery}" "$start"
    put_key "STOP_CHARGE_THRESH_${battery}" "$stop"

    [ -x "$TLP_BIN" ] && "$TLP_BIN" setcharge "$start" "$stop" "$battery" >/dev/null 2>&1 || true
    echo "charge thresholds set to ${start}-${stop} for ${battery}"
}

cmd_set_abm() {
    ac="${1:-}"
    bat="${2:-}"

    is_abm_level "$ac" || die "invalid AC backlight level"
    is_abm_level "$bat" || die "invalid battery backlight level"

    put_key AMDGPU_ABM_LEVEL_ON_AC "$ac"
    put_key AMDGPU_ABM_LEVEL_ON_BAT "$bat"

    # Re-running TLP applies the value and regenerates /run/tlp/run.conf,
    # which is what the panel reads back.
    reapply_tlp
    probe_abm >/dev/null

    echo "adaptive backlight set to ac=${ac} bat=${bat}"
}

cmd_set_wifi() {
    ac="${1:-}"
    bat="${2:-}"

    is_on_off "$ac" || die "invalid AC Wi-Fi power saving value"
    is_on_off "$bat" || die "invalid battery Wi-Fi power saving value"

    put_key WIFI_PWR_ON_AC "$ac"
    put_key WIFI_PWR_ON_BAT "$bat"

    reapply_tlp

    echo "wifi power saving set to ac=${ac} bat=${bat}"
}

cmd_set_runtime_pm() {
    ac="${1:-}"
    bat="${2:-}"

    is_on_auto "$ac" || die "invalid AC runtime power management value"
    is_on_auto "$bat" || die "invalid battery runtime power management value"

    put_key RUNTIME_PM_ON_AC "$ac"
    put_key RUNTIME_PM_ON_BAT "$bat"

    # Device-by-device application follows TLP's own denylist rules, so let
    # TLP do it rather than reimplementing them here.
    reapply_tlp

    echo "runtime power management set to ac=${ac} bat=${bat}"
}

cmd_set_cpu_freq() {
    ac="${1:-}"
    bat="${2:-}"

    is_cpu_freq "$ac" || die "invalid AC frequency limit"
    is_cpu_freq "$bat" || die "invalid battery frequency limit"

    put_key CPU_SCALING_MAX_FREQ_ON_AC "$ac"
    put_key CPU_SCALING_MAX_FREQ_ON_BAT "$bat"

    reapply_tlp

    echo "cpu frequency limit set to ac=${ac} bat=${bat}"
}

# Applying a system mode also sets the sub-settings it implies, so the panel
# needs one authorisation instead of four.
cmd_apply_preset() {
    preset="${1:-}"

    # Empty when the processor has no usable scaling limits; the frequency
    # keys are then skipped rather than written with a bogus value.
    cpu_lo=$(cpu_freq_min)
    cpu_hi=$(cpu_freq_max)

    case "$preset" in
        auto)
            put_key WIFI_PWR_ON_AC off
            put_key WIFI_PWR_ON_BAT on
            put_key RUNTIME_PM_ON_AC on
            put_key RUNTIME_PM_ON_BAT auto
            cpu_ac="$cpu_hi"
            cpu_bat="$cpu_lo"
            tlp_verb=start
            ;;
        bat)
            put_key WIFI_PWR_ON_AC on
            put_key WIFI_PWR_ON_BAT on
            put_key RUNTIME_PM_ON_AC auto
            put_key RUNTIME_PM_ON_BAT auto
            cpu_ac="$cpu_lo"
            cpu_bat="$cpu_lo"
            tlp_verb=bat
            ;;
        ac)
            put_key WIFI_PWR_ON_AC off
            put_key WIFI_PWR_ON_BAT off
            put_key RUNTIME_PM_ON_AC on
            put_key RUNTIME_PM_ON_BAT on
            cpu_ac="$cpu_hi"
            cpu_bat="$cpu_hi"
            tlp_verb=ac
            ;;
        *)
            die "unknown preset"
            ;;
    esac

    if [ -n "$cpu_lo" ] && [ -n "$cpu_hi" ] && [ "$cpu_lo" != "$cpu_hi" ]; then
        put_key CPU_SCALING_MAX_FREQ_ON_AC "$cpu_ac"
        put_key CPU_SCALING_MAX_FREQ_ON_BAT "$cpu_bat"
    fi

    [ -x "$TLP_BIN" ] && "$TLP_BIN" "$tlp_verb" >/dev/null 2>&1 || true
    echo "system mode ${preset} applied"
}

# Comment out the panel's keys where /etc/tlp.conf sets them, so its own file
# is free to take effect.
#
# This is the one place that touches /etc/tlp.conf, and it only ever runs when
# the user asks for it: that file is a dpkg conffile of the tlp package, and
# modifying it makes upgrades of tlp stop to ask what to do with it. Nothing
# is deleted — the old lines stay, commented, with the reason beside them.
cmd_release_overrides() {
    [ -f "$CONF_USR" ] || die "no user configuration found"

    if ! grep -qE "$MANAGED_RE" "$CONF_USR"; then
        echo "nothing in ${CONF_USR} overrides the panel"
        return 0
    fi

    mkdir -p "$STATE_DIR"
    if [ ! -f "$USR_BACKUP" ]; then
        cp -p "$CONF_USR" "$USR_BACKUP"
        chmod 644 "$USR_BACKUP"
    fi

    tmp="${CONF_USR}.tlp-panel-tmp.$$"
    awk -v re="$MANAGED_RE" '
        $0 ~ re { print "# " $0 "   # commented out by TLP Panel"; next }
        { print }
    ' "$CONF_USR" > "$tmp"

    chmod --reference="$CONF_USR" "$tmp" 2>/dev/null || chmod 644 "$tmp"
    chown --reference="$CONF_USR" "$tmp" 2>/dev/null || true
    mv "$tmp" "$CONF_USR"

    reapply_tlp

    echo "settings in ${CONF_USR} commented out; a copy of the original is at ${USR_BACKUP}"
}

cmd_clear() {
    rm -f "$CONF_FILE"
    echo "TLP Panel configuration removed"
}

verb="${1:-}"
[ -n "$verb" ] || die "no command given"
shift || true

case "$verb" in
    set-charge) cmd_set_charge "$@" ;;
    set-abm) cmd_set_abm "$@" ;;
    set-wifi) cmd_set_wifi "$@" ;;
    set-runtime-pm) cmd_set_runtime_pm "$@" ;;
    set-cpu-freq) cmd_set_cpu_freq "$@" ;;
    release-overrides) cmd_release_overrides ;;
    apply-preset) cmd_apply_preset "$@" ;;
    probe) cmd_probe ;;
    clear) cmd_clear ;;
    *) die "unknown command" ;;
esac
